# --- Telegram Bot API ---
# Get BOT_TOKEN from @BotFather on Telegram (/newbot)
BOT_TOKEN=

# The group chat containing you, your boss, and the bot.
# Find it via https://api.telegram.org/bot<TOKEN>/getUpdates after sending a message in the group.
GROUP_CHAT_ID=

# Your boss's numeric Telegram user id (found the same way, in message.from.id).
BOSS_USER_ID=

# --- Server ---
PORT=3000

# Any long random string. Used to sign session cookies.
SESSION_SECRET=change-this-to-a-random-string

# --- Hardcoded login accounts ---
# You (full control: change task status)
OWNER_USERNAME=owner
OWNER_PASSWORD=change-this-password

# Your boss (read-only view)
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-this-password
